# Model provider: "bedrock" or "groq" (default: groq)
MODEL_PROVIDER=groq

# Groq API key (used when MODEL_PROVIDER != bedrock)
GROQ_API_KEY=your_groq_api_key_here

# AWS credentials for Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS region (default: ap-northeast-2)
AWS_REGION=ap-northeast-2

# Bedrock model IDs (used when MODEL_PROVIDER=bedrock)
SONNET_MODEL_ID=anthropic.claude-sonnet-4-20250514
HAIKU_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0

# Bedrock Knowledge Base
BEDROCK_KB_ID=
BEDROCK_KB_DATA_SOURCE_ID=
KB_MODEL_ARN=arn:aws:bedrock:ap-northeast-2::foundation-model/anthropic.claude-sonnet-4-20250514

# Bedrock Guardrails
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# S3
S3_BUCKET_NAME=cas-contracts-megathon-26743

# DynamoDB
DYNAMODB_CONTRACTS_TABLE=cas-contracts
DYNAMODB_RISK_REPORTS_TABLE=cas-risk-reports
DYNAMODB_WORKFLOW_TABLE=cas-workflow-steps
DYNAMODB_PROMPTS_TABLE=cas-prompt-templates

# MCP (컴플라이언스 규정 DB)
COMPLIANCE_DB_PATH=data/compliance.db
